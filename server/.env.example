# Local dev — Postgres from docker-compose.yml at repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voipa

# better-auth (Phase 3 will start using these; safe placeholders for now)
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of additional origins allowed to call /api/auth/*.
# In dev, the Vite client runs on :5173 and needs to be trusted explicitly.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

PORT=3000
NODE_ENV=development
